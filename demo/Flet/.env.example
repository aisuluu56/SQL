# Скопируйте этот файл в .env и задайте свой пароль.
# Только для локальной учебной базы, НЕ для публикации в интернете.
POSTGRES_USER=flet_student
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_DB=flet_academy
POSTGRES_PORT=5433
# Те же пользователь, пароль, база и порт, что выше.
DATABASE_URL=postgresql://flet_student:replace_with_local_password@localhost:5433/flet_academy
